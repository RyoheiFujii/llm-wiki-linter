{
  "name": "llm-wiki-linter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && node -e \"const fs=require('fs');['dist/masters.js','dist/linter.js'].forEach(f=>{const s=fs.readFileSync(f,'utf8').replace(/^import\\s+.*?;\\r?\\n/gm,'').replace(/^export\\s+/gm,'');fs.writeFileSync(f,s);});fs.copyFileSync('src/appsscript.json','dist/appsscript.json');\"",
    "deploy": "npm run build && clasp push -f"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyoheiFujii/llm-wiki-linter.git"
  },
