  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/RyoheiFujii/llm-wiki-linter/issues"
  },
  "homepage": "https://github.com/RyoheiFujii/llm-wiki-linter#readme",
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "typescript": "^7.0.2"
  }
}
